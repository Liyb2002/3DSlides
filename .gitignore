# Only these are in the repo: the engine, the user folder, two talks, the README and its GIFs. Everything else
# stays local (video/, process.3Dslides/, readme.3Dslides/, 3DSlides.app, ...).
/*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/docs/
!/code/
!/user/
!/demo.3Dslides/
!/showcase.3Dslides/

# this machine's agent approval and sessions (code/agent.py writes it)
/user/agent.json

.DS_Store
__pycache__/
*.pyc
node_modules/
